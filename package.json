{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/build-server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server server.js",
    "lint": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist-server/server.js",
    "migrate:json-to-pg": "tsx scripts/migrate-json-to-pg.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "check:types": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:auth": "vitest run tests/integration/auth-session.test.ts tests/integration/auth-security.test.ts",
    "test:contracts": "vitest run tests/integration/contracts-query.test.ts tests/integration/contract-edits.test.ts",
    "test:workflow": "vitest run tests/unit/workflow-matrix.test.ts tests/integration/physical-workflow.test.ts",
    "test:payroll": "vitest run tests/unit/payroll-engine.test.ts tests/integration/payroll-queries.test.ts",
    "test:integration": "vitest run tests/integration --fileParallelism=false"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-table": "^8.21.2",
    "@vitejs/plugin-react": "^5.0.4",
    "argon2": "^0.45.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^25.16.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.1.0"
  }
}
