# ==============================================================================
# HỆ THỐNG QUẢN LÝ HỢP ĐỒNG NỘI BỘ - ENVIRONMENT CONFIGURATION
# Copy file này thành .env và điền các giá trị thực tế
# ==============================================================================

# Node Environment ('development' | 'production')
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL cho Production Stack)
# ------------------------------------------------------------------------------
# Chuỗi kết nối PostgreSQL (sử dụng khi chuyển đổi từ database.json sang Postgres)
DATABASE_URL=postgresql://postgres:postgres_secret_password@localhost:5432/contracts_db?sslmode=disable

# Thông số kết nối Docker Compose PostgreSQL (nếu chạy qua Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret_password
POSTGRES_DB=contracts_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI CONFIGURATION (Trích xuất hợp đồng thông minh)
# ------------------------------------------------------------------------------
# Lấy API Key từ Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. MICROSOFT TEAMS INTEGRATION (Thông báo kênh tự động)
# ------------------------------------------------------------------------------
# URL Webhook lấy từ MS Teams Channel -> Connectors -> Incoming Webhook
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-teams-channel-webhook-url

# ------------------------------------------------------------------------------
# 4. VIETTEL POST API CONFIGURATION (Giao nhận & Vận đơn)
# ------------------------------------------------------------------------------
# Tài khoản API Viettel Post (https://viettelpost.vn/partner)
VTP_BASE_URL=https://partner.viettelpost.vn/v2
VTP_USERNAME=your_vtp_username
VTP_PASSWORD=your_vtp_password
VTP_APP_TOKEN=your_vtp_partner_app_token
# Bưu cục gửi hàng mặc định của doanh nghiệp
VTP_SENDER_PROVINCE_ID=1
VTP_SENDER_DISTRICT_ID=1
VTP_SENDER_ADDRESS=Tòa nhà Hội sở Doanh nghiệp, Hà Nội

# ------------------------------------------------------------------------------
# 5. GOOGLE DRIVE BACKUP CONFIGURATION (Sao lưu hồ sơ số)
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_FOLDER_ID=root/contracts_backup_folder
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./config/google-service-account.json

# ------------------------------------------------------------------------------
# 6. SECURITY & JWT (Dành cho Production RBAC)
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_min32chars
SESSION_COOKIE_SECRET=session_cookie_secret_key_random_value
CORS_ORIGIN=*
